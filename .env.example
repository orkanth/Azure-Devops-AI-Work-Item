# Copy the required values into local environment files. Never commit secrets.

# NestJS API
API_PORT=3000
AI_SERVICE_URL=http://localhost:8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/azure_work_items

# Python AI service
AI_SERVICE_PORT=8000
LLM_PROVIDER=openai
LLM_MODEL=replace-with-supported-model
OPENAI_API_KEY=
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./local-data/chroma
CHROMA_COLLECTION_NAME=technical-documents

# Azure DevOps - use a secure backend secret store in deployed environments
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-organization
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=

# MCP server/client
AZURE_DEVOPS_MCP_TRANSPORT=stdio
